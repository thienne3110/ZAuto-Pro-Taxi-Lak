# HTTP / Socket.IO port
PORT=3000

# Auto-reply
AUTO_MODE_ENABLED=true
# All keywords must appear in a group message. Separate with "*" or ",".
AUTO_KEYWORDS=đón*trả*giá
AUTO_REPLY_MESSAGE=ok nhận

# Random delay (ms) before replying
REPLY_DELAY_MIN_MS=1500
REPLY_DELAY_MAX_MS=3000

# Where the QR png is written by zalo-api-final
QR_PATH=qr.png
